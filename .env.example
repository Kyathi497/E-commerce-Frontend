# Backend API gateway. Pages call /api/v1/* and /media/*, which are proxied here (set it at build
# time), and the server reads the catalog from it (at run time).
GATEWAY_URL=http://localhost:4000

# Shared by all services. catalog-service signs its calls to /api/revalidate with it, so pages
# refresh within seconds of an admin edit. Optional in development (a built-in dev value is used);
# required in production, the same value as in every service.
# SERVICE_TOKEN_SECRET=

# Google sign-in (Google Cloud Console → APIs & Services → Credentials → OAuth client ID, type "Web application").
# Authorised redirect URI: https://<your-domain>/api/auth/google/callback (and http://localhost:3000/api/auth/google/callback for dev).
# Use the same client ID as auth-service (auth-service/.env).
# Leave both empty here AND in auth-service to run Google sign-in in test mode (simulated, clearly labelled, dev only).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: set only if the redirect URI above differs from this site's own address (e.g. behind a proxy).
GOOGLE_REDIRECT_URI=
